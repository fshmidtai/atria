# Секреты окружения. Никогда не коммитить (файл .gitignore уже это гарантирует).
# Заполняется данными от KDD после регистрации аккаунтов.

# --- HuggingFace (датасеты + Spaces) ---
HF_TOKEN=
# репозиторий состояния роя, напр. <user>/atria-hive-state
HF_STATE_REPO=

# --- Supabase (общая память роя, v0.2) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Cloudflare (сайты колоний) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Oracle Always Free (улей) ---
ORACLE_IP=
ORACLE_SSH_USER=ubuntu
# путь к приватному SSH-ключу
ORACLE_SSH_KEY=

# --- Бесплатные LLM-провайдеры (опционально, v0.1 работает и без них) ---
# 1) self-hosted на Oracle-узле
LOCAL_LLM_URL=
# 2) https://console.groq.com
GROQ_API_KEY=
# 3) https://openrouter.ai (есть free-модели)
OPENROUTER_API_KEY=

# --- GitHub (репозиторий роя) ---
GITHUB_TOKEN=
